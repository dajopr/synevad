# Copy to `.env`; every run script sources it. Nothing here has a useful default — the
# paths are your machine's, and the two model paths are only needed if you score with
# EditReward.

# --- datasets -------------------------------------------------------------------------
# The official MVTec AD root, as downloaded: <cat>/{train/good,test,ground_truth}.
MVTEC_SRC=/path/to/MVTec

# The train/gen split scripts/make_split.sh writes: the first N frames per category go to
# <cat>/source for generation, every other train frame stays in <cat>/train/good for the
# detector. Never point this at MVTEC_SRC.
MVTEC_PATH=data/synevad/MVTec

# The pooled split scripts/make_split_pools.py writes, which both synthetic arms train on
# (synevad/config/{ablate_split,draem_split}.yaml). A few frames per seed in train/good,
# every other frame free to carry a defect. Separate tree from MVTEC_PATH.
MVTEC_SPLIT_PATH=data/synevad/MVTec_pools

# Describable Textures, for the DRAEM arm's Perlin overlays. Must contain images/<class>/*.jpg.
# Download it yourself; scripts/generate_draem.py only prints the wget line if it is missing.
DTD_PATH=/path/to/dtd

# --- generated corpora ----------------------------------------------------------------
# Where each arm's generated images live. Read by the sweep configs of the same name.
SYNTHETIC_BENCH=data/bench/mvtec       # scripts/generate_standalone_sweep.py (FLUX)
FLUX_ABLATE_BENCH=data/bench/v3        # the v3 FLUX corpus, synevad/config/ablate_split.yaml
DRAEM_BENCH=data/bench/draem           # scripts/generate_draem.py

# --- MLflow ---------------------------------------------------------------------------
# A tracking server is required for multi-GPU sweeps (--gpus with more than one id);
# SQLite is refused. Leave empty for a local single-process run.
MLFLOW_TRACKING_URI=

# Where MLflow writes runs and artifacts. Every synevad config reads this as `logging.root`.
MLFLOW_DIR=data/mlflow

# Only when the tracking server runs on this host: read artifacts off disk rather than over
# HTTP (synevad.db.read). Unset it anywhere else, or reads will look in the wrong place.
# MLFLOW_LOCAL_ARTIFACT_ROOT=/path/to/mlartifacts

# --- EditReward (optional) ------------------------------------------------------------
# Only needed for scripts/score_manifests.py and the `scoring:` block of a generation
# config, which write reward_score / scorer into the generation manifests.
EDITREWARD_CHECKPOINT=
EDITREWARD_CONFIG=
